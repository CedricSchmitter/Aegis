# Copy to /srv/aegis/deploy/.env on the VM; ops/deploy/init-secrets.sh generates it with random secrets.
# Never commit the real file.
AEGIS_COMMIT=dev
AEGIS_DATA_DIR=/srv/aegis/data
AEGIS_EXPORTS_DIR=/srv/aegis/exports
AEGIS_DB_PASSWORD=change-me
PAPERLESS_DB_PASSWORD=change-me
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_ADMIN_USER=aegis-service
PAPERLESS_ADMIN_PASSWORD=change-me
