# Plain LAN HTTP mode, used by CI and until clients trust the local CA. No TLS is terminated here, so no
# secure-context features (installable PWA, Web Push) are available. Trusted HTTPS mode: Caddyfile.https.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	reverse_proxy aegis:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
