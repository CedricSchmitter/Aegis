{
  "name": "aegis-promo",
  "private": true,
  "type": "module",
  "description": "Promo video tooling: mocked API, scene recordings and the Remotion composition. Not part of the app.",
  "scripts": {
    "mock": "node mock/server.mjs",
    "docs": "node record/render-docs.mjs",
    "record": "node record/record.mjs",
    "music": "python3 music/synth.py",
    "studio": "remotion studio video/index.ts",
    "render": "remotion render video/index.ts Promo out/aegis-promo.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --codec=h264 --crf=16",
    "still": "remotion still video/index.ts Promo --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "music:calm": "python3 music/synth_calm.py",
    "render:calm": "remotion render video/index.ts Calm out/aegis-promo-calm.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --codec=h264 --crf=16",
    "still:calm": "remotion still video/index.ts Calm --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "music:v11": "python3 music/synth_v11.py",
    "render:v11": "remotion render video/index.ts V11 out/aegis-promo-v11.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --codec=h264 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "playwright": "1.63.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
